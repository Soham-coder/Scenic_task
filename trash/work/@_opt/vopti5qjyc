library verilog;
use verilog.vl_types.all;
entity piso is
    port(
        clk             : in     vl_logic;
        enable          : in     vl_logic;
        rst             : in     vl_logic;
        data            : in     vl_logic_vector(15 downto 0);
        \out\           : out    vl_logic
    );
end piso;
