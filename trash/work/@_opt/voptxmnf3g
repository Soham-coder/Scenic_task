    attribute mti_svvh_generic_type : integer;
    attribute mti_svvh_generic_type of X_DIM : constant is 1;
    attribute mti_svvh_generic_type of Y_DIM : constant is 1;
    attribute mti_svvh_generic_type of DATA_WIDTH : constant is 1;
    attribute mti_svvh_generic_type of FIFO_DEPTH_WIDTH : constant is 1;
    attribute mti_svvh_generic_type of actn_h : constant is 1;
    attribute mti_svvh_generic_type of actn_w : constant is 1;
    attribute mti_svvh_generic_type of actn_c : constant is 1;
    attribute mti_svvh_generic_type of filt_h : constant is 1;
    attribute mti_svvh_generic_type of filt_w : constant is 1;
    attribute mti_svvh_generic_type of filt_c : constant is 1;
    attribute mti_svvh_generic_type of num_filt : constant is 1;
    attribute mti_svvh_generic_type of stride : constant is 1;
    attribute mti_svvh_generic_type of out_h : constant is 3;
    attribute mti_svvh_generic_type of out_w : constant is 3;
    attribute mti_svvh_generic_type of out_c : constant is 3;
    attribute mti_svvh_generic_type of blk_h : constant is 3;
    attribute mti_svvh_generic_type of blk_w : constant is 3;
    attribute mti_svvh_generic_type of DEFAULT : constant is 1;
    attribute mti_svvh_generic_type of LD_WT_SRAM2PE : constant is 1;
    attribute mti_svvh_generic_type of LD_IF_SRAM2BUF : constant is 1;
    attribute mti_svvh_generic_type of LD_IF_BUF2PE : constant is 1;
    attribute mti_svvh_generic_type of DNNEXEC : constant is 1;
    attribute mti_svvh_generic_type of UNLD_OF_PE2BUF : constant is 1;
    attribute mti_svvh_generic_type of UNLD_OF_BUF2SRAM : constant is 1;
end conv_tb_v2;
